{
	"info": {
		"_postman_id": "8d4f6c4a-3456-4b1e-9d2e-6a4d7f9e2b1c",
		"name": "AI Voice Agent API",
		"description": "API collection for the Artizence Voice Agent Integration.\n\n### Backends\n- **Core API (Django)**: `http://localhost:8000`\n- **Streaming API (FastAPI)**: `http://localhost:8001`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication (Core 8000)",
			"item": [
				{
					"name": "Login (Obtain JWT)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"your_username\",\n    \"password\": \"your_password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:8000/api/token/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8000",
							"path": ["api", "token", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access) {",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"    console.log(\"Access token set automatically\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"newuser\",\n    \"password\": \"securepassword\",\n    \"email\": \"user@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:8000/api/register/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8000",
							"path": ["api", "register", ""]
						}
					}
				},
				{
					"name": "Token Refresh",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"your_refresh_token_here\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:8000/api/token/refresh/",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8000",
							"path": ["api", "token", "refresh", ""]
						}
					}
				}
			]
		},
		{
			"name": "Core Resources (Core 8000)",
			"item": [
				{
					"name": "Agents - List All",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": "http://localhost:8000/api/agents/"
					}
				},
				{
					"name": "Agents - Create",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Friendly Assistant\",\n    \"voice_id\": \"aura-asteria-en\",\n    \"system_prompt\": \"You are a helpful assistant.\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": "http://localhost:8000/api/agents/"
					}
				},
				{
					"name": "Agents - Detail",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": "http://localhost:8000/api/agents/1/"
					}
				},
				{
					"name": "Sessions - List",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": "http://localhost:8000/api/sessions/"
					}
				},
				{
					"name": "Messages - List (Filter by Session)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{"key": "token", "value": "{{access_token}}", "type": "string"}]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8000/api/messages/?session=1",
							"protocol": "http",
							"port": "8000",
							"path": ["api", "messages", ""],
							"query": [{"key": "session", "value": "1"}]
						}
					}
				}
			]
		},
		{
			"name": "Streaming API (FastAPI 8001)",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8001/health"
					}
				},
				{
					"name": "System Info (Voices/Models)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8001/info"
					}
				},
				{
					"name": "WebSocket Endpoint Reference",
					"request": {
						"method": "GET",
						"header": [],
						"description": "This is a WebSocket endpoint. Use a WebSocket client (like Postman's WS request or wscat) to connect.\n\nURL: `ws://localhost:8001/ws/chat/{agent_id}?token={access_token}&session={session_id}`",
						"url": "http://localhost:8001/ws/chat/1"
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		}
	]
}
